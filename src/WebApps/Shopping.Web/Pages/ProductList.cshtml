@page
@model ProductListModel
@{
    ViewData["Title"] = "Oyuncaklar";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold">
            <i class="fas fa-toys me-2"></i>
            Tüm Oyuncaklar 
            <span class="badge bg-primary">@Model.ProductList.Count()</span>
        </h2>
        <p class="text-muted">En kaliteli oyuncakları keşfedin</p>
    </div>
</div>

<!-- Category Filter -->
<div class="card mb-4">
    <div class="card-body">
        <h5 class="mb-3"><i class="fas fa-filter me-2"></i>Kategoriler</h5>
        <div class="row g-2">
            <div class="col-auto">
                <a href="@Url.Page("/ProductList")" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-list me-1"></i>Tümü
                </a>
            </div>
            <div class="col-auto">
                <a href="@Url.Page("/ProductList", new { category = "Yapı Setleri" })" class="btn btn-outline-secondary btn-sm">
                    🏗️ Yapı Setleri
                </a>
            </div>
            <div class="col-auto">
                <a href="@Url.Page("/ProductList", new { category = "Bebekler" })" class="btn btn-outline-secondary btn-sm">
                    👸 Bebekler
                </a>
            </div>
            <div class="col-auto">
                <a href="@Url.Page("/ProductList", new { category = "Araçlar" })" class="btn btn-outline-secondary btn-sm">
                    🚗 Araçlar
                </a>
            </div>
            <div class="col-auto">
                <a href="@Url.Page("/ProductList", new { category = "Elektronik Oyuncaklar" })" class="btn btn-outline-secondary btn-sm">
                    🎮 Elektronik
                </a>
            </div>
            <div class="col-auto">
                <a href="@Url.Page("/ProductList", new { category = "Eğitici Oyuncaklar" })" class="btn btn-outline-secondary btn-sm">
                    🎓 Eğitici
                </a>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.CategoryName))
{
    <div class="alert alert-info border-0 rounded-3 mb-4">
        <h5 class="mb-1">Kategori: @Model.CategoryName</h5>
        <p class="mb-0">@Model.ProductList.Count() ürün bulundu</p>
    </div>
}

<!-- Products Grid -->
@if (Model.ProductList.Any())
{
    <div class="row g-4">
        @foreach (var product in Model.ProductList)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <partial name="_ProductItemPartial" model="@product" />
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <div style="font-size: 4rem; color: #7F8C8D;">🔍</div>
        <h4 class="text-muted mb-3">Bu kategoride ürün bulunamadı</h4>
        <p class="text-muted mb-4">Başka kategorilere göz atabilirsiniz</p>
        <a href="@Url.Page("/ProductList")" class="btn btn-primary">
            <i class="fas fa-list me-2"></i>Tüm Ürünleri Görüntüle
        </a>
    </div>
}

<!-- Special Offers -->
@if (Model.ProductList.Any())
{
    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header text-white" style="background: linear-gradient(45deg, #FF6B6B, #4ECDC4) !important;">
                    <h5><i class="fas fa-gift me-2"></i>Özel Teklifler</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <div class="me-3" style="font-size: 2rem;">🎁</div>
                                <div>
                                    <h6 class="mb-1">Hediye Paketi</h6>
                                    <small class="text-muted">Ücretsiz hediye paketi</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <div class="me-3" style="font-size: 2rem;">💳</div>
                                <div>
                                    <h6 class="mb-1">Taksit İmkanı</h6>
                                    <small class="text-muted">12 aya varan taksit</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <div class="me-3" style="font-size: 2rem;">⚡</div>
                                <div>
                                    <h6 class="mb-1">Hızlı Teslimat</h6>
                                    <small class="text-muted">Aynı gün kargo</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .card-header {
        border: none !important;
        color: white !important;
        font-weight: 700 !important;
        padding: 1.5rem !important;
    }
    
    .btn {
        border-radius: 15px !important;
        font-weight: 600 !important;
        transition: all 0.3s ease;
    }
    
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }
    
    .btn-outline-secondary:hover {
        background: linear-gradient(45deg, #4ECDC4, #A8E6CF) !important;
        border-color: transparent !important;
        color: white !important;
    }
</style>
