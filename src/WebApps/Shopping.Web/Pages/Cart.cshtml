@page
@model Shopping.Web.Pages.CartModel
@{
    ViewData["Title"] = "Shopping Cart - Review Your Items";
}

<!-- Breadcrumb -->
<div class="container">
    <nav aria-label="breadcrumb" class="modern-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-page="Index">
                    <i class="fas fa-home me-1"></i>Home
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-page="ProductList">Products</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Shopping Cart
            </li>
        </ol>
    </nav>
</div>

<!-- Page Header -->
<div class="container mb-4">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="page-title">
                    <i class="fas fa-shopping-cart me-2"></i>
                    Shopping Cart
                </h1>
                <p class="page-subtitle">Review your selected items before checkout</p>
            </div>
            <div class="col-md-4 text-md-end">
                <div class="cart-progress">
                    <div class="progress-step active">
                        <span class="step-number">1</span>
                        <span class="step-text">Cart</span>
                    </div>
                    <div class="progress-line"></div>
                    <div class="progress-step">
                        <span class="step-number">2</span>
                        <span class="step-text">Checkout</span>
                    </div>
                    <div class="progress-line"></div>
                    <div class="progress-step">
                        <span class="step-number">3</span>
                        <span class="step-text">Payment</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <!-- Cart Items -->
        <div class="col-lg-8">
            <div class="cart-section">
                <div class="cart-header">
                    <h3 class="section-title">Cart Items (@Model.Cart.Items.Count())</h3>
                    <div class="cart-actions">
                        <button class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-heart me-1"></i>Save for Later
                        </button>
                        <button class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-trash me-1"></i>Clear Cart
                        </button>
                    </div>
                </div>

                <div class="cart-items">
                    @foreach (var cartItem in Model.Cart.Items)
                    {
                        <div class="cart-item">
                            <div class="item-image">
                                <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80"
                                     alt="@cartItem.ProductName" class="product-thumbnail">
                            </div>

                            <div class="item-details">
                                <h5 class="item-name">@cartItem.ProductName</h5>
                                <div class="item-meta">
                                    <span class="item-sku">SKU: #@cartItem.ProductId</span>
                                    <span class="item-status available">
                                        <i class="fas fa-check-circle me-1"></i>In Stock
                                    </span>
                                </div>
                                <div class="item-features">
                                    <span class="feature-badge">
                                        <i class="fas fa-shipping-fast me-1"></i>Free Shipping
                                    </span>
                                    <span class="feature-badge">
                                        <i class="fas fa-shield-alt me-1"></i>2 Year Warranty
                                    </span>
                                </div>
                            </div>

                            <div class="item-quantity">
                                <label class="quantity-label">Quantity</label>
                                <div class="quantity-controls">
                                    <button class="quantity-btn quantity-decrease" type="button">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <input class="quantity-input" type="number" value="@cartItem.Quantity" min="1" max="10">
                                    <button class="quantity-btn quantity-increase" type="button">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="item-price">
                                <div class="price-info">
                                    <span class="unit-price">$@cartItem.Price each</span>
                                    <span class="total-price">$@(cartItem.Price * cartItem.Quantity)</span>
                                </div>
                            </div>

                            <div class="item-actions">
                                <button class="action-btn save-btn" title="Save for Later">
                                    <i class="fas fa-heart"></i>
                                </button>
                                <form asp-page-handler="removetocart" method="post" class="d-inline">
                                    <button class="action-btn remove-btn" type="submit" title="Remove Item">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    <input type="hidden" asp-for="@cartItem.ProductId" name="productId" />
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <!-- Continue Shopping -->
                <div class="continue-shopping">
                    <a asp-page="ProductList" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Continue Shopping
                    </a>
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-4">
            <div class="order-summary">
                <div class="summary-header">
                    <h4 class="summary-title">Order Summary</h4>
                </div>

                <div class="summary-content">
                    <div class="summary-row">
                        <span class="summary-label">Subtotal (@Model.Cart.Items.Count() items)</span>
                        <span class="summary-value">$@Model.Cart.TotalPrice</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Shipping</span>
                        <span class="summary-value free">Free</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Tax</span>
                        <span class="summary-value">$@((Model.Cart.TotalPrice * 0.08).ToString("F2"))</span>
                    </div>
                    <div class="summary-separator"></div>
                    <div class="summary-row total-row">
                        <span class="summary-label">Total</span>
                        <span class="summary-value">$@((Model.Cart.TotalPrice * 1.08).ToString("F2"))</span>
                    </div>
                </div>

                <div class="summary-actions">
                    <a asp-page="Checkout" class="btn btn-primary btn-lg checkout-btn">
                        <i class="fas fa-lock me-2"></i>
                        Secure Checkout
                    </a>

                    <div class="payment-methods">
                        <span class="payment-text">We accept:</span>
                        <div class="payment-icons">
                            <i class="fab fa-cc-visa"></i>
                            <i class="fab fa-cc-mastercard"></i>
                            <i class="fab fa-cc-amex"></i>
                            <i class="fab fa-cc-paypal"></i>
                        </div>
                    </div>

                    <div class="security-info">
                        <i class="fas fa-shield-alt me-2"></i>
                        <span>Your information is secure and encrypted</span>
                    </div>
                </div>
            </div>

            <!-- Promo Code -->
            <div class="promo-section">
                <div class="promo-header">
                    <h5 class="promo-title">Have a Promo Code?</h5>
                </div>
                <div class="promo-content">
                    <div class="input-group">
                        <input type="text" class="form-control promo-input" placeholder="Enter promo code">
                        <button class="btn btn-outline-primary" type="button">Apply</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Page Header */
.page-header {
    background: white;
    border-radius: var(--border-radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
}

.page-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--dark-color);
    margin-bottom: 0.5rem;
}

.page-subtitle {
    color: #6b7280;
    font-size: 1.1rem;
    margin: 0;
}

/* Progress Steps */
.cart-progress {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.progress-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
}

.step-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #e5e7eb;
    color: #6b7280;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    transition: var(--transition);
}

.progress-step.active .step-number {
    background: var(--primary-color);
    color: white;
}

.step-text {
    font-size: 0.8rem;
    color: #6b7280;
    font-weight: 500;
}

.progress-step.active .step-text {
    color: var(--primary-color);
}

.progress-line {
    width: 2rem;
    height: 2px;
    background: #e5e7eb;
}

/* Cart Section */
.cart-section {
    background: white;
    border-radius: var(--border-radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
}

.cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #f3f4f6;
}

.section-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--dark-color);
    margin: 0;
}

.cart-actions {
    display: flex;
    gap: 0.75rem;
}

/* Cart Items */
.cart-items {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.cart-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    background: #f9fafb;
    border-radius: var(--border-radius);
    transition: var(--transition);
}

.cart-item:hover {
    background: #f3f4f6;
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
}

.item-image {
    flex-shrink: 0;
}

.product-thumbnail {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-sm);
}

.item-details {
    flex: 1;
    min-width: 0;
}

.item-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--dark-color);
    margin-bottom: 0.5rem;
    line-height: 1.3;
}

.item-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
}

.item-sku {
    color: #6b7280;
    font-size: 0.9rem;
}

.item-status {
    display: flex;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 500;
}

.item-status.available {
    color: var(--success-color);
}

.item-features {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.feature-badge {
    background: #e0f2fe;
    color: #0369a1;
    padding: 0.25rem 0.5rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
}

/* Quantity Controls */
.item-quantity {
    text-align: center;
}

.quantity-label {
    display: block;
    font-size: 0.85rem;
    color: #6b7280;
    margin-bottom: 0.5rem;
    font-weight: 500;
}

.quantity-controls {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    background: white;
}

.quantity-btn {
    background: none;
    border: none;
    padding: 0.5rem;
    color: #6b7280;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
}

.quantity-btn:hover {
    background: var(--primary-color);
    color: white;
}

.quantity-input {
    border: none;
    width: 50px;
    text-align: center;
    padding: 0.5rem 0.25rem;
    font-weight: 600;
    color: var(--dark-color);
}

.quantity-input:focus {
    outline: none;
    background: #f9fafb;
}

/* Item Price */
.item-price {
    text-align: right;
    min-width: 120px;
}

.price-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.unit-price {
    font-size: 0.85rem;
    color: #6b7280;
}

.total-price {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--danger-color);
}

/* Item Actions */
.item-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.action-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    cursor: pointer;
}

.save-btn {
    background: #fef3c7;
    color: #d97706;
}

.save-btn:hover {
    background: #fbbf24;
    color: white;
}

.remove-btn {
    background: #fee2e2;
    color: #dc2626;
}

.remove-btn:hover {
    background: #ef4444;
    color: white;
}

/* Continue Shopping */
.continue-shopping {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e7eb;
}

/* Order Summary */
.order-summary {
    background: white;
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    margin-bottom: 2rem;
    position: sticky;
    top: 2rem;
}

.summary-header {
    background: var(--primary-gradient);
    color: white;
    padding: 1.5rem;
}

.summary-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
}

.summary-content {
    padding: 1.5rem;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.summary-label {
    color: #6b7280;
    font-weight: 500;
}

.summary-value {
    font-weight: 600;
    color: var(--dark-color);
}

.summary-value.free {
    color: var(--success-color);
}

.summary-separator {
    height: 1px;
    background: #e5e7eb;
    margin: 1.5rem 0;
}

.total-row {
    margin-bottom: 0;
}

.total-row .summary-label,
.total-row .summary-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--dark-color);
}

.summary-actions {
    padding: 1.5rem;
    background: #f9fafb;
}

.checkout-btn {
    width: 100%;
    margin-bottom: 1.5rem;
    padding: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.payment-methods {
    text-align: center;
    margin-bottom: 1rem;
}

.payment-text {
    font-size: 0.85rem;
    color: #6b7280;
    display: block;
    margin-bottom: 0.5rem;
}

.payment-icons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    font-size: 1.5rem;
    color: #6b7280;
}

.security-info {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: #059669;
    background: #d1fae5;
    padding: 0.75rem;
    border-radius: var(--border-radius-sm);
}

/* Promo Section */
.promo-section {
    background: white;
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
}

.promo-header {
    background: #f3f4f6;
    padding: 1rem 1.5rem;
}

.promo-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--dark-color);
}

.promo-content {
    padding: 1.5rem;
}

.promo-input {
    border-radius: var(--border-radius-sm) 0 0 var(--border-radius-sm);
}

/* Responsive */
@media (max-width: 992px) {
    .order-summary {
        position: static;
    }

    .cart-progress {
        margin-top: 1rem;
    }
}

@media (max-width: 768px) {
    .cart-item {
        flex-direction: column;
        text-align: center;
        gap: 1rem;
    }

    .item-details {
        order: 1;
    }

    .item-quantity {
        order: 2;
    }

    .item-price {
        order: 3;
        text-align: center;
    }

    .item-actions {
        order: 4;
        flex-direction: row;
        justify-content: center;
    }

    .cart-header {
        flex-direction: column;
        gap: 1rem;
    }

    .page-title {
        font-size: 2rem;
    }
}
</style>
