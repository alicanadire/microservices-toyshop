@page
@model Shopping.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white text-center">
                    <h4><i class="fa fa-ban"></i> Access Denied</h4>
                </div>
                <div class="card-body text-center">
                    <i class="fa fa-exclamation-triangle text-warning" style="font-size: 64px;"></i>
                    <h5 class="mt-3">You don't have permission to access this page</h5>
                    <p class="text-muted">Please contact your administrator if you believe this is an error.</p>
                    <div class="mt-4">
                        <a href="/" class="btn btn-primary">
                            <i class="fa fa-home"></i> Go to Home
                        </a>
                        <a href="/Account/Login" class="btn btn-outline-primary">
                            <i class="fa fa-sign-in"></i> Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
