@page
@model Shopping.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h4><i class="fa fa-sign-in"></i> Welcome Back</h4>
                    <p class="mb-0">Sign in to your account</p>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <a href="/Account/Challenge" class="btn btn-lg btn-primary btn-block">
                            <i class="fa fa-sign-in"></i> Sign In with EShop Identity
                        </a>
                    </div>
                    <hr>
                    <div class="text-center">
                        <p class="text-muted">
                            Don't have an account? 
                            <a href="/Account/Register" class="text-primary">Sign up here</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
