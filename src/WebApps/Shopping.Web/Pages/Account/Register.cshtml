@page
@model Shopping.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h4><i class="fa fa-user-plus"></i> Join EShop</h4>
                    <p class="mb-0">Create your account</p>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <a href="/Account/Challenge" class="btn btn-lg btn-success btn-block">
                            <i class="fa fa-user-plus"></i> Sign Up with EShop Identity
                        </a>
                    </div>
                    <hr>
                    <div class="text-center">
                        <p class="text-muted">
                            Already have an account? 
                            <a href="/Account/Login" class="text-primary">Sign in here</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
