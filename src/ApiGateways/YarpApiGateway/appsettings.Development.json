{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Yarp": "Debug",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "Microsoft.AspNetCore.Authorization": "Debug"
      }
    }
  },
  "IdentityServerSettings": {
    "Authority": "http://localhost:6006",
    "ApiName": "gateway",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster-dev",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/catalog-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" },
          { "RequestHeader": "X-Environment", "Set": "Development" }
        ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster-dev",
        "AuthorizationPolicy": "CustomerAccess",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/basket-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" },
          { "RequestHeader": "X-Environment", "Set": "Development" }
        ]
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster-dev",
        "AuthorizationPolicy": "CustomerAccess",
        "RateLimiterPolicy": "ordering",
        "Match": {
          "Path": "/ordering-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" },
          { "RequestHeader": "X-Environment", "Set": "Development" }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster-dev": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:6000"
          }
        }
      },
      "basket-cluster-dev": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:6001"
          }
        }
      },
      "ordering-cluster-dev": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:6003"
          }
        }
      }
    }
  }
}
